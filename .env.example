# ============================================================
# GLOWALCHEMY Backend — Environment Variables (example / template)
#
# Copy this file to `.env` and fill in real values. NEVER commit
# your real `.env` file. Keep secrets out of source control.
# ============================================================

# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Optional fallback connection string (standard, non-SRV) used if the SRV lookup fails
# MONGODB_URI_STANDARD=

# Server
PORT=8000
NODE_ENV=development
# When running behind a reverse proxy, keep TRUST_PROXY=true. Set to false otherwise.
TRUST_PROXY=true

# JWT Configuration (required) — generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# User/Admin frontend URLs (used for CORS & email links)
USER_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:5000

# CORS allowed origins (comma-separated). In production this MUST be set.
# Same-origin requests are always allowed.
CORS_ORIGINS=https://glowalchemy.in,https://admin.glowalchemy.in

# Frontend API/socket URLs (informational only — set in the frontend apps)
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_SOCKET_URL=http://localhost:8000

# Gmail SMTP (Nodemailer)
MAIL_USER=your_smtp_user@example.com
MAIL_PASS=your_smtp_password
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=GLOWALCHEMY <your_smtp_user@example.com>

# Shiprocket API Credentials
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_DEFAULT_COURIER_ID=1
SHIPROCKET_PICKUP_LOCATION=Primary

# Shiprocket Webhook (dynamic path - change as needed)
SHIPROCKET_WEBHOOK_PATH=/api/webhooks/shipping
SHIPROCKET_WEBHOOK_SECRET=your_webhook_secret_here
SHIPROCKET_WEBHOOK_TOKEN=your_webhook_token_here

# Shiprocket Package Defaults
SHIPROCKET_PKG_LENGTH=10
SHIPROCKET_PKG_BREADTH=10
SHIPROCKET_PKG_HEIGHT=10
SHIPROCKET_PKG_WEIGHT=0.5

# Meta Conversions API (CAPI) Configuration
# Get your Access Token from: https://business.facebook.com/events_manager
# Pixel ID should match your existing Meta Pixel
META_PIXEL_ID=0000000000000000
META_CAPI_ACCESS_TOKEN=YOUR_CAPI_ACCESS_TOKEN_HERE

# OpenAI (server-side AI for admin tools). Leave empty to disable.
# OPENAI_API_KEY=

# Optional: Test Event Code for debugging (get from Events Manager > Test Events)
# Remove or leave empty for production
META_CAPI_TEST_EVENT_CODE=

# Optional: Data Processing Options (JSON format)
# Example: '["LDU"]' for Limited Data Use
META_CAPI_DATA_OPTIONS=

# Object storage — Backblaze B2 via its S3-compatible API (private bucket)
# AWS_ACCESS_KEY_ID=<BACKBLAZE_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<BACKBLAZE_APPLICATION_KEY>
# AWS_REGION=us-east-005
# AWS_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# AWS_S3_BUCKET=<BACKBLAZE_BUCKET_NAME>
# STORAGE_SIGNED_URL_EXPIRES_IN=3600

# MSG91 (OTP SMS)
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER=
# MSG91_ROUTE=
# MSG91_COUNTRY=

# Razorpay (model fields exist but integration is not yet active)
# Uncomment when Razorpay is integrated:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# PhonePe Payments
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=1
# PHONEPE_ENV=UAT
# PHONEPE_ALLOW_PROD_IN_DEV=false
# PHONEPE_WEBHOOK_USERNAME=
# PHONEPE_WEBHOOK_PASSWORD=

# Rate limiting (tune per environment)
RATE_LIMIT_WINDOW_MS_PUBLIC=60000
RATE_LIMIT_MAX_PUBLIC=600
RATE_LIMIT_WINDOW_MS_AUTH=900000
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_WINDOW_MS_ADMIN=60000
RATE_LIMIT_MAX_ADMIN=120
RATE_LIMIT_MAX_DEV=2000

# Catalog / search tuning (all optional — safe defaults in code)
CATALOG_CACHE_TTL_SECONDS=15
CATALOG_CACHE_MAX_ENTRIES=300
SEARCH_AUTOCOMPLETE_MIN_CHARS=3
SEARCH_CANDIDATE_CAP=150
CATALOG_PAGE_SIZE_MAX=100
